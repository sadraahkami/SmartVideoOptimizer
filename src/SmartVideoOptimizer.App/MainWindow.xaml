<Window x:Class="SmartVideoOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartVideoOptimizer.App.ViewModels"
        xmlns:domain="clr-namespace:SmartVideoOptimizer.Core.Domain;assembly=SmartVideoOptimizer.Core"
        xmlns:conv="clr-namespace:SmartVideoOptimizer.App.Converters"
        mc:Ignorable="d"
        Title="SmartVideoOptimizer - Precision Video Compression Studio"
        Height="820" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />

        <SolidColorBrush x:Key="CyanAccent" Color="#0284C7" />
        <SolidColorBrush x:Key="CardBackground" Color="#131B2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#1E293B" />

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="{Binding FlowDirectionText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Navigation Header -->
            <RowDefinition Height="*" />    <!-- Screen Container -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION HEADER -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,32,0">
                    <Border Width="34" Height="34" Background="#0284C7" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SmartVideo" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <TextBlock Text="Optimizer" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="3,0,0,0" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetScreenCommand}" CommandParameter="{x:Static vm:AppScreen.Home}" Margin="0,0,8,0">
                        <TextBlock Text="🏠 Home" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetScreenCommand}" CommandParameter="{x:Static vm:AppScreen.Optimize}" IsEnabled="{Binding HasAsset}" Margin="0,0,8,0">
                        <TextBlock Text="⚙️ Optimize" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetScreenCommand}" CommandParameter="{x:Static vm:AppScreen.Queue}" Margin="0,0,8,0">
                        <TextBlock Text="📋 Queue" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetScreenCommand}" CommandParameter="{x:Static vm:AppScreen.Results}" IsEnabled="{Binding LastValidationResult, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="🏆 Results" />
                    </Button>
                </StackPanel>

                <!-- Right Actions: Language Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleLanguageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="12" />
                            <TextBlock Text="{Binding LanguageToggleText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY VIEWPORT -->
        <Grid Grid.Row="1" Margin="24,16">

            <!-- SCREEN 1: HOME VIEW (Dropzone & Quick Landing) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Home}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#0D1322" BorderBrush="#1E293B" BorderThickness="2"
                        CornerRadius="16" Margin="12"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        Cursor="Hand"
                        MouseDown="DropZone_MouseDown">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="88" Height="88" Background="#131C31" CornerRadius="44"
                                BorderBrush="#1E293B" BorderThickness="2"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DropBoxTitle}" FontSize="22" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DropBoxSubtitle}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,24" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding BrowseFileCommand}" HorizontalAlignment="Center" Padding="28,12">
                            <TextBlock Text="{Binding BrowseButtonText}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SCREEN 2: OPTIMIZE WORKSPACE -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Optimize}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Top Media Summary Bar -->
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentAsset.FileName}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CurrentAsset.HumanReadableFileSize}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding CurrentAsset.HumanReadableDuration}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                                        </Border>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding PrimaryVideo.ResolutionLabel}" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentAsset.FilePath}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClearButtonText}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Goal Selector: Exact Size | Best Quality | Smart Compress -->
                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="COMPRESSION GOAL / هدف فشرده‌سازی" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12" />
                                <UniformGrid Columns="3" Margin="0,0,0,16">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetGoalCommand}" CommandParameter="{x:Static domain:CompressionGoal.ExactSize}" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎯 " />
                                            <TextBlock Text="Exact Size (اندازه دقیق)" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetGoalCommand}" CommandParameter="{x:Static domain:CompressionGoal.BestQuality}" Margin="3,0,3,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💎 " />
                                            <TextBlock Text="Best Quality (حداکثر کیفیت)" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetGoalCommand}" CommandParameter="{x:Static domain:CompressionGoal.SmartCompress}" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🧠 " />
                                            <TextBlock Text="Smart Compress (فشرده‌سازی هوشمند)" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <!-- Exact Size Parameter Controls -->
                                <StackPanel Visibility="{Binding IsExactSizeGoal, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Target File Size (MB):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <Slider Grid.Column="1" Minimum="10" Maximum="2000" Value="{Binding TargetSizeMb}" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="12,6" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding TargetSizeMb, StringFormat='{}{0} MB'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                    </Grid>
                                    <CheckBox Content="Strictly Never Exceed Target Size (تضمین عدم عبور از سقف تعیین‌شده)" IsChecked="{Binding NeverExceedTarget}" Foreground="#94A3B8" />
                                </StackPanel>

                                <!-- Smart Compress Recommendation Banner -->
                                <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                        Visibility="{Binding IsSmartCompressGoal, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="🤖 Smart Compress Lite Analysis:" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SmartRecommendation.SummaryPersian}" FontSize="13" Foreground="#E0E7FF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Quality Guard Visual Impact Indicator -->
                                <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="#1E293B" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Quality Guard Assessment: " FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                                <TextBlock Text="{Binding QualityRisk.Risk}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding QualityRiskText}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Preview Comparison Banner (If Generated) -->
                        <Border Background="#064E3B" BorderBrush="#047857" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                Visibility="{Binding PreviewResult, Converter={StaticResource NullToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="⚡ 10-Second Smart Preview Ready" FontWeight="Bold" Foreground="#A7F3D0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding PreviewResult.OriginalSizeBytes, StringFormat='Original: {0} B'}" FontSize="12" Foreground="#D1FAE5" />
                                        <TextBlock Text=" ➔ " Foreground="#6EE7B7" />
                                        <TextBlock Text="{Binding PreviewResult.CompressedSizeBytes, StringFormat='Compressed: {0} B'}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <TextBlock Text="{Binding PreviewResult.ReductionPercentage, StringFormat=' ({0}% smaller)'}" FontSize="12" FontWeight="Bold" Foreground="#34D399" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Bar: Preview & Start Encoding -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding GeneratePreviewCommand}" Margin="0,0,12,0" Padding="20,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️ " />
                                    <TextBlock Text="Quick Preview (پیش‌نمایش ۱۰ ثانیه)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartEncodingCommand}" Padding="28,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 " />
                                    <TextBlock Text="Start Optimization (شروع فشرده‌سازی)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SCREEN 3: QUEUE & LIVE MONITOR -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Queue}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Active Encoding Monitor Card -->
                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ENCODING TASK / وظیفه فعال" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CurrentAsset.FileName}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Command="{Binding CancelEncodingCommand}">
                                    <TextBlock Text="Cancel Job (انصراف)" />
                                </Button>
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar Height="10" Value="{Binding Progress.Percentage, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Foreground="#0284C7" Background="#1E293B" BorderThickness="0" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROGRESS" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Progress.Percentage, StringFormat='{}{0:F1}%'}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SPEED" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Progress.HumanReadableSpeed}" FontSize="16" FontWeight="Bold" Foreground="#10B981" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FPS" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Progress.Fps, StringFormat='{}{0:F0} FPS'}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="REMAINING ETA" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Progress.HumanReadableEta}" FontSize="16" FontWeight="Bold" Foreground="#C4B5FD" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Persistent Job Queue History (SQLite) -->
                    <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PERSISTENT QUEUE &amp; HISTORY (SQLITE)" FontSize="13" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QueueJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#161F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                                        <TextBlock Text="{Binding State, StringFormat='Status: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CompressionRatio, StringFormat='Saved: {0}%'}" FontSize="12" FontWeight="Bold" Foreground="#34D399" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- SCREEN 4: RESULTS VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="{x:Static vm:AppScreen.Results}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="16" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="72" Height="72" Background="#064E3B" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="Optimization Successfully Verified!" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="فشرده‌سازی با موفقیت انجام و استانداردهای کیفی تایید شدند." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <!-- Metric Highlights -->
                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <Border Background="#161F33" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT SIZE" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding LastValidationResult.HumanReadableActualSize}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#161F33" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="VALIDATION STATUS" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="Passed ✓" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}" Margin="0,0,10,0">
                                <TextBlock Text="▶ Play Video (پخش ویدیو)" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0">
                                <TextBlock Text="📁 Open Folder (پوشه خروجی)" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearFileCommand}">
                                <TextBlock Text="➕ New Job (فایل جدید)" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ERROR ALERT -->
            <Border Background="#7F1D1D" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="14"
                    VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FEE2E2" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SmartVideoOptimizer v1.0 | Engine: FFmpeg 9.0.2 &amp; .NET 10 LTS | SQLite Persistent Queue" FontSize="11" Foreground="#475569" />
            </Grid>
        </Border>
    </Grid>
</Window>
