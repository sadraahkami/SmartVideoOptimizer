<Window x:Class="SmartVideoOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartVideoOptimizer.App.ViewModels"
        xmlns:conv="clr-namespace:SmartVideoOptimizer.App.Converters"
        mc:Ignorable="d"
        Title="SmartVideoOptimizer - Professional Media Analyzer"
        Height="800" Width="1150"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />

        <!-- Glow Brush -->
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4" />
        <SolidColorBrush x:Key="CyanHover" Color="#22D3EE" />
        <SolidColorBrush x:Key="CardBackground" Color="#131B2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#1E293B" />
        <SolidColorBrush x:Key="BadgeBg" Color="#1E293B" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="{Binding FlowDirectionText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header -->
            <RowDefinition Height="*" />    <!-- Main Content -->
            <RowDefinition Height="Auto" /> <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION HEADER -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#0284C7" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SmartVideo" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Optimizer" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="3,0,0,0" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v0.1 Foundation" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Next-Gen Architecture &amp; Precision Media Engine" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions: Language Switch -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 " FontSize="12" />
                            <TextBlock Text="{Binding LanguageToggleText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTENT -->
        <Grid Grid.Row="1" Margin="24,16">

            <!-- STATE 1: DRAG & DROP ZONE (When HasAsset is false) -->
            <Grid Visibility="{Binding HasAsset, Converter={StaticResource InverseBoolToVis}}">
                <Border Background="#0D1322" BorderBrush="#1E293B" BorderThickness="2"
                        CornerRadius="16" Margin="12"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop"
                        Cursor="Hand"
                        MouseDown="DropZone_MouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#1E293B" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#0284C7" />
                                    <Setter Property="Background" Value="#0F182E" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Icon Bubble -->
                        <Border Width="88" Height="88" Background="#131C31" CornerRadius="44"
                                BorderBrush="#1E293B" BorderThickness="2"
                                HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="🎬" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding DropBoxTitle}"
                                   FontSize="22" FontWeight="Bold" Foreground="#F1F5F9"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />

                        <TextBlock Text="{Binding DropBoxSubtitle}"
                                   FontSize="13" Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,0,0,24" />

                        <Button Style="{StaticResource ModernButton}" Command="{Binding BrowseFileCommand}"
                                HorizontalAlignment="Center" Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="14" />
                                <TextBlock Text="{Binding BrowseButtonText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- STATE 2: MEDIA INFORMATION DASHBOARD (When HasAsset is true) -->
            <Grid Visibility="{Binding HasAsset, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Asset Summary Header -->
                    <RowDefinition Height="Auto" /> <!-- Overview Cards (4 KPI Cards) -->
                    <RowDefinition Height="*" />    <!-- Streams Details (Audio + Subtitles) -->
                </Grid.RowDefinitions>

                <!-- Asset Summary Header Bar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1"
                        CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- File Info -->
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎬 " FontSize="16" />
                                <TextBlock Text="{Binding CurrentAsset.FileName}" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" />
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentAsset.FilePath}" FontSize="12" Foreground="#64748B" Margin="24,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Clear / Re-select Button -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearFileCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕ " FontSize="12" Foreground="#EF4444" />
                                <TextBlock Text="{Binding ClearButtonText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4 KPI Overview Cards -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                    <!-- KPI 1: Duration & Size -->
                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="DURATION &amp; SIZE" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding CurrentAsset.HumanReadableDuration}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentAsset.HumanReadableFileSize, StringFormat='File Size: {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Video Resolution & FPS -->
                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="VIDEO RESOLUTION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PrimaryVideo.ResolutionLabel}" FontSize="22" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock Text="{Binding PrimaryVideo.FrameRate, StringFormat=' @ {0:F1} FPS'}" FontSize="14" FontWeight="SemiBold" Foreground="#6EE7B7" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                            </StackPanel>
                            <TextBlock Text="{Binding PrimaryVideo.AspectRatio, StringFormat='Aspect: {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Codec & Format -->
                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="CODEC &amp; CONTAINER" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding PrimaryVideo.Codec, TargetNullValue='No Video'}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CurrentAsset.Container.FormatName, StringFormat='Container: {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Color, Bit Depth & HDR -->
                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="COLOR &amp; DYNAMIC RANGE" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <!-- 10-bit badge -->
                                <Border Background="#4C1D95" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PrimaryVideo.BitDepth, StringFormat='{}{0}-Bit'}" FontSize="11" FontWeight="Bold" Foreground="#C4B5FD" />
                                </Border>
                                <!-- HDR Badge -->
                                <Border Background="#78350F" CornerRadius="4" Padding="6,2" Visibility="{Binding PrimaryVideo.IsHdr, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PrimaryVideo.Color.HdrType}" FontSize="11" FontWeight="Bold" Foreground="#FDE68A" />
                                </Border>
                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Visibility="{Binding PrimaryVideo.IsHdr, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="SDR Standard" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PrimaryVideo.Color.ColorPrimaries, StringFormat='Primaries: {0}', TargetNullValue='Standard'}" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Detailed Streams Section (2 Columns: Audio & Subtitles) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Audio Tracks Panel -->
                    <Border Grid.Column="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🔊 " FontSize="16" />
                                <TextBlock Text="{Binding AudioDetailsHeader}" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" />
                                <Border Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding AudioTracksCount, StringFormat='{}{0} Tracks'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentAsset.AudioStreams}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#161F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="28" Height="28" Background="#1E293B" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Index, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Language}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                                                            <TextBlock Text="{Binding Title, StringFormat=' - {0}'}" FontSize="12" Foreground="#94A3B8" Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ChannelsLabel}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding Codec}" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                                        </Border>
                                                        <Border Background="#0369A1" CornerRadius="4" Padding="6,2" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Default" FontSize="10" FontWeight="Bold" Foreground="#BAE6FD" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Subtitle Tracks Panel -->
                    <Border Grid.Column="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="💬 " FontSize="16" />
                                <TextBlock Text="{Binding SubtitleDetailsHeader}" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" />
                                <Border Background="#1E293B" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SubtitleTracksCount, StringFormat='{}{0} Tracks'}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Empty state when 0 subtitles -->
                                    <TextBlock Text="No internal subtitle tracks detected in this container."
                                               FontSize="12" Foreground="#64748B" FontStyle="Italic"
                                               Margin="0,20,0,0" HorizontalAlignment="Center"
                                               Visibility="{Binding SubtitleTracksCount, Converter={StaticResource InverseBoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding CurrentAsset.SubtitleStreams}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161F33" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="28" Height="28" Background="#1E293B" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Index, StringFormat='#{0}'}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Language}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                                                                <TextBlock Text="{Binding Title, StringFormat=' - {0}'}" FontSize="12" Foreground="#94A3B8" Visibility="{Binding Title, Converter={StaticResource NullToVis}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Codec}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#581C87" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" Visibility="{Binding IsImageBased, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="PGS / Bitmap" FontSize="10" FontWeight="Bold" Foreground="#E9D5FF" />
                                                            </Border>
                                                            <Border Background="#0369A1" CornerRadius="4" Padding="6,2" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Default" FontSize="10" FontWeight="Bold" Foreground="#BAE6FD" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- LOADING OVERLAY -->
            <Border Background="#B20B0F19" CornerRadius="12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6" Foreground="#0284C7" Background="#1E293B" BorderThickness="0" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ERROR NOTIFICATION BANNER -->
            <Border Background="#7F1D1D" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="14"
                    VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️ " FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13" Foreground="#FEE2E2" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusReadyText}" FontSize="11" Foreground="#94A3B8" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Engine: ffprobe 9.0.2 Native | .NET 10 LTS | Architecture: x64" FontSize="11" Foreground="#475569" />
            </Grid>
        </Border>
    </Grid>
</Window>
